# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/

# playwright testing artifacts
.playwright-mcp/
*.playwright-mcp.*

# scripts y seeds locales (contienen contraseñas de prueba y lógica de hasheo; no
# deben versionarse ni exponerse en el repositorio público)
/scripts/
prisma/seed.ts
prisma/seed-demo.ts
prisma/seed-test-estudiante.ts
check_user.js
test-db.js
