#SUPABASE
NEXT_PUBLIC_SUPABASE_URL=XXXX
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=XXXX
NEXT_PUBLIC_SUPABASE_ANON_KEY=XXXX
SUPABASE_SECRET_KEY=XXXX
# Alias requerido por /api/upload/archivo (Supabase Storage bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=XXXX

#PRISMA
# DATABASE_URL → pooler en modo Transaction (6543) para runtime
# DIRECT_URL   → pooler en modo Session    (5432) para prisma migrate / db pull
DATABASE_URL=postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

#ENVIO DE CORREOS (Gmail SMTP)
EMAIL_USER=XXXX
EMAIL_PASS=XXXX
EMAIL_FROM=XXXX

#URL base para los links en los emails (sin slash final)
NEXT_PUBLIC_URL=http://localhost:3000

#CLOUDINARY
CLOUDINARY_CLOUD_NAME=XXXX
CLOUDINARY_API_KEY=XXXX
CLOUDINARY_API_SECRET=XXXX

#AI API KEYS
GOOGLE_GENERATIVE_AI_API_KEY=XXXX
ANTHROPIC_API_KEY=XXXX

#AGENTE DE OPENROUTER (para LLMs)
OPENROUTER_API_KEY=XXXX
OPENROUTER_API_KEY_CALCULADORA=XXXX

#API KEYS DE GEMINI (AGENTE CV)
GEMINI_API_KEY=XXXX
GEMINI_API_KEY_2=XXXX

#INICIOS DE SESION CON GOOGLE Y GITHUB
GOOGLE_CLIENT_ID=XXXX
GOOGLE_CLIENT_SECRET=XXXX
GITHUB_CLIENT_ID=XXXX
GITHUB_CLIENT_SECRET=XXXX
AUTH_TOKEN_SECRET=XXXX
