# === Supabase (Auth) ===
# La ANON KEY es PÚBLICA por diseño (va con NEXT_PUBLIC_). NUNCA pongas aquí la
# service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Base de datos (Postgres de Supabase, vía Prisma) ===
# Supabase > Settings > Database > Connection string.
DATABASE_URL=   # pooled (puerto 6543, con ?pgbouncer=true)
DIRECT_URL=     # directa (puerto 5432, para migraciones)
