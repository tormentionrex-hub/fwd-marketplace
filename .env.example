# === Supabase (Auth en el frontend) ===
# La ANON KEY es PÚBLICA por diseño (no es secreta). NUNCA pongas aquí ni en el
# frontend la service_role key: esa va solo en el backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === Backend NestJS (repo aparte) ===
# En local: http://localhost:3001 — en producción: https://api.tu-dominio.com
# API_URL lo usa el servidor de Next (SSR / Route Handlers).
# NEXT_PUBLIC_API_URL lo usa el navegador (Client Components) y requiere CORS.
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
