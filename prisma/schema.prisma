}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model perfiles_estudiante {
  id_usuario              String                    @id @db.Uuid
  titulo_profesional      String?                   @db.VarChar(150)
  estado_verificacion     String?                   @db.VarChar(50)
  reputacion              Int                       @default(0)
  total_calificaciones    Int                       @default(0)
  descripcion             String?
  document_url            String?
  generacion_fwd          Int?
  chats                   chats[]
  curriculums             curriculums?
  entregables             entregables[]
  estudiantes_habilidades estudiantes_habilidades[]
