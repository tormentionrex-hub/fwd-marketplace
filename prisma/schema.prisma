  cierre                DateTime?               @db.Timestamptz(6)
  chats                 chats[]
  conversaciones_ia     conversaciones_ia[]
  cv_accesos            cv_accesos[]
  entregables           entregables[]
  evaluaciones          evaluaciones[]
  ofertas               ofertas[]
  proyecto_mejoras      proyecto_mejoras[]
  perfiles_empresario   perfiles_empresario     @relation(fields: [id_empresario], references: [id_usuario], map: "fk_proyectos_empresario")
  proyectos_tecnologias proyectos_tecnologias[]

  @@index([estado], map: "idx_proyectos_estado")
  @@index([id_empresario], map: "idx_proyectos_id_empresario")
  @@index([publicado], map: "idx_proyectos_publicado")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model proyectos_tecnologias {
  id_proyecto   String      @db.Uuid
  id_tecnologia BigInt
  proyectos     proyectos   @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, map: "fk_proyectos_tecnologias_proyecto")
  tecnologias   tecnologias @relation(fields: [id_tecnologia], references: [id], onDelete: Cascade, map: "fk_proyectos_tecnologias_tecnologia")

  @@id([id_proyecto, id_tecnologia])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model roles {
  id       BigInt     @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(100)
  usuarios usuarios[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model tecnologias {
  id                    BigInt                  @id @default(autoincrement())
  nombre                String                  @unique @db.VarChar(150)
  proyectos_tecnologias proyectos_tecnologias[]
}

/// Códigos OTP de recuperación de contraseña. El código se guarda hasheado (scrypt).
/// Migración SQL en prisma/sql/password_resets.sql (aplicar en Supabase).
model password_resets {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario  String   @db.Uuid
  codigo_hash String
  expira      DateTime @db.Timestamptz(6)
  intentos    Int      @default(0)
  verificado  Boolean  @default(false)
  usado       Boolean  @default(false)
  creado      DateTime @default(now()) @db.Timestamptz(6)
  usuarios    usuarios @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_usuario], map: "idx_password_resets_id_usuario")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model usuarios {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre              String               @db.VarChar(150)
  correo              String               @unique @db.VarChar(255)
  hash_contrasena     String
  image_url           String?
  estado              String               @default("activo") @db.VarChar(50)
  id_rol              BigInt
  fecha_nacimiento    DateTime?            @db.Date
  creado              DateTime             @default(now()) @db.Timestamptz(6)
  segundo_apellido    String?              @db.VarChar(150)
  ultima_sesion       DateTime?            @db.Timestamptz(6)
  mensajes            mensajes[]
  notificaciones      notificaciones[]
  password_resets     password_resets[]
  perfiles_empresario perfiles_empresario?
  perfiles_estudiante perfiles_estudiante?
  roles               roles                @relation(fields: [id_rol], references: [id], map: "fk_usuarios_roles")

  @@index([estado], map: "idx_usuarios_estado")
  @@index([id_rol], map: "idx_usuarios_id_rol")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model curriculums {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_usuario          String              @unique @db.Uuid
  file_name           String              @db.VarChar(255)
