generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model chats {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_proyecto         String              @db.Uuid
  id_estudiante       String              @db.Uuid
  id_empresario       String              @db.Uuid
  creado              DateTime            @default(now()) @db.Timestamptz(6)
  ultimo_mensaje      DateTime?           @db.Timestamptz(6)
  perfiles_empresario perfiles_empresario @relation(fields: [id_empresario], references: [id_usuario], onDelete: Cascade, map: "fk_chats_empresario")
  perfiles_estudiante perfiles_estudiante @relation(fields: [id_estudiante], references: [id_usuario], onDelete: Cascade, map: "fk_chats_estudiante")
  proyectos           proyectos           @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, map: "fk_chats_proyecto")
  mensajes            mensajes[]

  @@unique([id_proyecto, id_estudiante, id_empresario], map: "unique_chat_proyecto_estudiante_empresario")
  @@index([id_proyecto], map: "idx_chats_id_proyecto")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model conversaciones_ia {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_empresario       String              @db.Uuid
  id_proyecto         String              @db.Uuid
  historial           Json?
  estado              String?             @db.VarChar(50)
  creado              DateTime            @default(now()) @db.Timestamptz(6)
  perfiles_empresario perfiles_empresario @relation(fields: [id_empresario], references: [id_usuario], onDelete: Cascade, map: "fk_conversaciones_ia_empresario")
  proyectos           proyectos           @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, map: "fk_conversaciones_ia_proyecto")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model entregables {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_proyecto           String              @db.Uuid
  id_estudiante         String              @db.Uuid
  tipo                  String?             @db.VarChar(100)
  version               Int                 @default(1)
  archivo_url           String
  estado                String              @default("enviado") @db.VarChar(50)
  creado                DateTime            @default(now()) @db.Timestamptz(6)
  comentario_empresario String?
  perfiles_estudiante   perfiles_estudiante @relation(fields: [id_estudiante], references: [id_usuario], onDelete: Cascade, map: "fk_entregables_estudiante")
  proyectos             proyectos           @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, map: "fk_entregables_proyecto")

  @@index([id_proyecto], map: "idx_entregables_id_proyecto")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model estudiantes_habilidades {
  id_usuario          String              @db.Uuid
  id_habilidad        BigInt
  nivel               String?             @db.VarChar(50)
  perfiles_estudiante perfiles_estudiante @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, map: "fk_estudiantes_habilidades_estudiante")
  habilidades         habilidades         @relation(fields: [id_habilidad], references: [id], onDelete: Cascade, map: "fk_estudiantes_habilidades_habilidad")

  @@id([id_usuario, id_habilidad])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model evaluaciones {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_proyecto         String              @db.Uuid
  id_estudiante       String              @db.Uuid
  id_empresario       String              @db.Uuid
  puntuacion          Int
  comentario          String?
  creado              DateTime            @default(now()) @db.Timestamptz(6)
  perfiles_empresario perfiles_empresario @relation(fields: [id_empresario], references: [id_usuario], onDelete: Cascade, map: "fk_evaluaciones_empresario")
  perfiles_estudiante perfiles_estudiante @relation(fields: [id_estudiante], references: [id_usuario], onDelete: Cascade, map: "fk_evaluaciones_estudiante")
  proyectos           proyectos           @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, map: "fk_evaluaciones_proyecto")

  @@unique([id_proyecto, id_estudiante, id_empresario], map: "unique_evaluacion_estudiante_proyecto")
  @@index([id_estudiante], map: "idx_evaluaciones_id_estudiante")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model habilidades {
  id                      BigInt                    @id @default(autoincrement())
  nombre                  String                    @db.VarChar(150)
  categoria               String?                   @db.VarChar(100)
  estudiantes_habilidades estudiantes_habilidades[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model mejoras {
  id               BigInt             @id @default(autoincrement())
  codigo           String             @unique @db.VarChar(100)
  nombre           String             @db.VarChar(150)
  descripcion      String?
  precio           Decimal            @default(0) @db.Decimal(10, 2)
  moneda           String             @default("USD") @db.VarChar(10)
  activa           Boolean            @default(true)
  creado           DateTime           @default(now()) @db.Timestamptz(6)
  actualizado      DateTime           @default(now()) @db.Timestamptz(6)
  proyecto_mejoras proyecto_mejoras[]
