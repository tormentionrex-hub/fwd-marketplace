  es_publico          Boolean             @default(false)
  subido              DateTime            @default(now()) @db.Timestamptz(6)
  actualizado         DateTime            @default(now()) @db.Timestamptz(6)
  perfiles_estudiante perfiles_estudiante @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
  cv_accesos          cv_accesos[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model cv_accesos {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_curriculum       String              @db.Uuid
  id_empresario       String              @db.Uuid
  id_proyecto         String?             @db.Uuid
  accion              String              @default("ver") @db.VarChar(20)
  creado              DateTime            @default(now()) @db.Timestamptz(6)
  curriculums         curriculums         @relation(fields: [id_curriculum], references: [id], onDelete: Cascade, onUpdate: NoAction)
  perfiles_empresario perfiles_empresario @relation(fields: [id_empresario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
  proyectos           proyectos?          @relation(fields: [id_proyecto], references: [id], onUpdate: NoAction)

  @@index([id_curriculum], map: "idx_cv_accesos_curriculum")
  @@index([id_empresario], map: "idx_cv_accesos_empresario")
}
