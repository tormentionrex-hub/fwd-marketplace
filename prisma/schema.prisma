  documentacion_url   String?
  perfiles_estudiante perfiles_estudiante @relation(fields: [id_estudiante], references: [id_usuario], onDelete: Cascade, map: "fk_ofertas_estudiante")
  proyectos           proyectos           @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, map: "fk_ofertas_proyecto")

  @@unique([id_proyecto, id_estudiante], map: "unique_oferta_estudiante_proyecto")
  @@index([estado], map: "idx_ofertas_estado")
  @@index([id_estudiante], map: "idx_ofertas_id_estudiante")
  @@index([id_proyecto], map: "idx_ofertas_id_proyecto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
